#
# yk-key: manage YubiKey GPG signing keys and the Git signing key.
#
# A single POSIX sh script. It needs jq; `current` and `add` use gpg to read
# the inserted card, and `git` needs git. Full documentation: docs/usage.md
# in the yk-key repository, or `yk-key --help`.
#
# SYNOPSIS
#   yk-key [list] [-n|-f|-s|-k] [-l LEN] [-j]
#   yk-key [info|show] QUERY [-N|-F|-S] [-n|-f|-s|-k] [-l LEN] [-j]
#   yk-key current [-n|-f|-s|-k] [-l LEN] [-j]
#   yk-key add [-j]
#   yk-key edit QUERY [-N|-F|-S] [-j]
#   yk-key rm QUERY [-N|-F|-S] [-y] [-j]
#   yk-key git [QUERY] [-g] [-n|-f|-s|-k] [-l LEN] [-j]
#
# EXIT STATUS
#   0  Success, or help or the version was shown
#   1  No match, an ambiguous match, no database, no card, no SSH key set
#      (with -k, without --json), a missing dependency, a rejected entry, an
#      aborted removal, or a failed write
#   2  Unknown option, invalid --length, or a missing QUERY

# SC2016: jq programs are single-quoted on purpose. SC2088: ~ is printed, not
# expanded. SC2154: m_* are assigned by eval in yk_match.
# shellcheck disable=SC2016,SC2088,SC2154
YK_KEY_VERSION=1.1.0

unset CDPATH
tab=$(printf '\t')

# ---------------------------------------------------------------- output ----

# colors: set the palette, or blank it when colour is off.
colors() {
  if [ -n "${NO_COLOR-}" ]; then
    c_reset='' c_cmd='' c_flag='' c_arg='' c_dim='' c_head=''
    c_warn='' c_err='' c_ok='' c_accent='' c_hi=''
    return 0
  fi
  e=$(printf '\033')
  c_reset="${e}[0m" c_cmd="${e}[94m" c_flag="${e}[92m" c_arg="${e}[36m"
  c_dim="${e}[90m" c_head="${e}[1;36m" c_warn="${e}[33m" c_err="${e}[31m"
  c_ok="${e}[32m" c_accent="${e}[32m" c_hi="${e}[1;37m"
}

# err MSG: print an error in red on stderr, always.
err() { printf '%s%s%s\n' "$c_err" "$1" "$c_reset" >&2; }

# qerr MSG [COLOR]: print an error on stderr unless -q.
qerr() {
  [ "$is_silent" -eq 1 ] && return 0
  printf '%s%s%s\n' "${2-$c_err}" "$1" "$c_reset" >&2
}

# tilde PATH: print PATH with a leading $HOME shown as ~.
tilde() {
  case $1 in
    "$HOME"/*) printf '~/%s' "${1#"$HOME"/}" ;;
    *) printf '%s' "$1" ;;
  esac
}

# fmt_fp FINGERPRINT: print FINGERPRINT cut to $fp_len (the last 8 or 16
# characters, or all of it).
fmt_fp() {
  case $fp_len in
    short) printf '%s\n' "$1" | sed 's/^.*\(.\{8\}\)$/\1/' ;;
    long) printf '%s\n' "$1" | sed 's/^.*\(.\{16\}\)$/\1/' ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# emit_json FIELD NAME FP SERIAL SSH [KEY=VALUE]...: print one entry as a
# JSON object. Extras come first; empty values become null. With a FIELD
# other than all, the object holds only that key.
emit_json() {
  _f=$1 _n=$2 _p=$3 _s=$4 _k=$5
  shift 5
  jq -n --arg field "$_f" --arg n "$_n" --arg f "$_p" --arg s "$_s" --arg k "$_k" '
    def nz: if . == "" then null else . end;
    ([$ARGS.positional[] | index("=") as $i | {(.[:$i]): (.[$i + 1:] | nz)}] | add // {})
      + {name: ($n | nz), fingerprint: ($f | nz), serial: ($s | nz), "ssh-key": ($k | nz)}
    | if $field == "all" then . else {($field): .[$field]} end
  ' --args "$@"
}

# print_entry COLOR NAME FP SERIAL SSH: the one-line form info and current
# print for a key.
print_entry() {
  if [ "$is_silent" -eq 1 ]; then
    printf '%s\t%s\t%s\t%s\n' "$2" "$3" "$4" "$5"
    return 0
  fi
  printf '%s%s%s  %sfingerprint=%s%s%s  %sserial=%s%s%s' \
    "$1" "$2" "$c_reset" "$c_dim" "$c_arg" "$3" "$c_reset" "$c_dim" "$c_accent" "$4" "$c_reset"
  [ -n "$5" ] && printf '  %sssh-key=%s%s' "$c_dim" "$(tilde "$5")" "$c_reset"
  echo
}

# print_field NAME FP SERIAL SSH: print the field chosen with -n/-f/-s/-k,
# or the whole entry (in $c_hi). Returns 1 when -k finds no SSH key.
print_field() {
  case $out_field in
    name) printf '%s\n' "$1" ;;
    fingerprint) printf '%s\n' "$2" ;;
    serial) printf '%s\n' "$3" ;;
    ssh-key)
      if [ -z "$4" ]; then
        qerr "yk-key: '$1' has no SSH key set" "$c_warn"
        return 1
      fi
      printf '%s\n' "$4"
      ;;
    *) print_entry "$c_hi" "$1" "$2" "$3" "$4" ;;
  esac
}

